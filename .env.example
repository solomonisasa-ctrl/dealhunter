# Copy this file to .env and fill in real values for local runs.
# In GitHub Actions, these same names are set as repo Secrets instead
# (Settings -> Secrets and variables -> Actions) - never commit .env.

# --- Reddit (reddit.com/prefs/apps -> create a "script" app) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=dealhunter/0.1 by u/your-reddit-username

# --- eBay (developer.ebay.com -> Production keyset) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Anthropic (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- ntfy.sh (no account needed, pick a private topic name) ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=dealhunter-changeme

# --- Paths (defaults are fine for local + CI) ---
DEALHUNTER_DATA_DIR=data
DEALHUNTER_CONFIG_DIR=config
